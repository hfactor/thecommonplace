{{- $months := dict -}}
{{- range .Site.RegularPages -}}
  {{- $s := .Section -}}
  {{- if and (eq $s "reading") (ne (index .Params "reading-status") "reading") (ne .Params.layout "listing") -}}
    {{- $key := dateFormat "2006-01" .Date -}}
    {{- $uid := printf "reading/%s" .File.ContentBaseName -}}
    {{- $entry := dict
      "uid"         $uid
      "type"        "reading"
      "day"         (int (dateFormat "2" .Date))
      "title"       .Title
      "date"        (dateFormat "Jan 2, 2006" .Date)
      "author"      (default "" .Params.author)
      "localTitle"  (default "" .Params.localTitle)
      "language"    (default "" .Params.language)
      "genre"       (default "" .Params.genre)
      "recommended" (or (eq .Params.recommended true) (eq (lower (printf "%v" (default "" .Params.recommended))) "yes"))
      "image"       (default "" .Params.image)
      "link"        (default "" .Params.link)
      "permalink"   .RelPermalink
    -}}
    {{- $existing := slice -}}
    {{- with index $months $key -}}{{- $existing = . -}}{{- end -}}
    {{- $months = merge $months (dict $key ($existing | append $entry)) -}}
  {{- end -}}
{{- end -}}
{{ $months | jsonify }}
